# Optional JSON objects used by the opt-in live integration tests.
# Put real secrets in a secret manager or untracked local .env file.

PROCORA_SQLSERVER_OPTIONS={"connection_string":"DRIVER={ODBC Driver 18 for SQL Server};SERVER=localhost,1433;DATABASE=accounting;UID=app;PWD=replace-me;Encrypt=yes;TrustServerCertificate=yes;"}
PROCORA_POSTGRESQL_OPTIONS={"dsn":"postgresql://app:replace-me@localhost:5432/accounting"}
PROCORA_MYSQL_OPTIONS={"host":"localhost","database":"accounting","user":"app","password":"replace-me"}

# Destructive integration tests create and drop objects. Use disposable databases only.
PROCORA_INTEGRATION_POSTGRESQL_OPTIONS={"dsn":"postgresql://app:replace-me@localhost:5432/procora_test"}
PROCORA_INTEGRATION_MYSQL_OPTIONS={"host":"localhost","database":"procora_test","user":"root","password":"replace-me"}
PROCORA_INTEGRATION_SQLSERVER_OPTIONS={"connection_string":"DRIVER={ODBC Driver 18 for SQL Server};SERVER=localhost,1433;DATABASE=procora_test;UID=sa;PWD=replace-me;Encrypt=yes;TrustServerCertificate=yes;"}
